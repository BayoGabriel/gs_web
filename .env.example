# GitShop web environment
# All values are optional; every form degrades honestly when unset.

# Base URL of the GitShop API (app_backend). Powers /signin and /signup.
# Example: http://localhost:8080
VITE_API_BASE_URL=

# Endpoint that accepts POST {name,email,topic,message} for the contact form.
VITE_CONTACT_API_URL=

# Canonical origin used for absolute URLs (canonical, OG).
VITE_SITE_URL=https://gitshop.app
